[Unit]
Description=EVE Abyss Tracker
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/eve-abyss-tracker
ExecStart=/opt/eve-abyss-tracker/venv/bin/python app.py
Restart=always
RestartSec=5
Environment=PORT=5051
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
